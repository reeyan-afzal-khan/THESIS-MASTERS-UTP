%=========Used for bookmarks
\newcommand{\autoBookmark}[2]{
	\ifstrequal{#1}{chap}{
		\pdfbookmark[1]{\thechapter: #2}{chap:\thechapter}
	}{
		\ifstrequal{#1}{sec}{
			\pdfbookmark[2]{\thesection: #2}{sec:\thesection}
		}{
			\ifstrequal{#1}{subsec}{
				\pdfbookmark[3]{\thesubsection: #2}{subsec:\thesubsection}
			}{
				\ifstrequal{#1}{subsubsec}{
					\pdfbookmark[4]{\thesubsubsection: #2}{subsubsec:\thesubsubsection}
				}{
					% Do nothing for unmatched types
				}
			}
		}
	}
}

% default allows section depth up to /paragraph
\setcounter{secnumdepth}{3}

\setcounter{chapter}{0}
\setcounter{section}{0}
\setcounter{subsection}{1}
\setcounter{subsubsection}{1}

\newcounter{appendixcounter}
\setcounter{appendixcounter}{1}


\renewcommand{\appendix}{
    \setcounter{chapter}{0}
    \renewcommand{\thechapter}{\Alph{chapter}}
    \renewcommand{\@thischapterhead}{APPENDIX \Alph{chapter}}
}

\def\@thischapterhead{CHAPTER \arabic{chapter}}

\def\@makechapterhead#1{%
    \vspace*{50\p@}%
    {\parindent \z@ \centering
        \begin{center}
            \rm \@thischapterhead\\
        \end{center}
        \interlinepenalty\@M
        \normalfont\uppercase{#1} \par\nobreak
        \vskip 40\p@
    }}



\def\appendixchapter#1{%
    \newpage
    \cleardoublepage
    \vspace{2in}
    \begin{center}
        {APPENDIX \Alph{appendixcounter}}\\
    \end{center}
    \centering\normalsize\normalfont\uppercase{#1}
    \chapter*{}
    \addcontentsline{toc}{appendixcounter}{#1}
    \cleardoublepage
}



% \@startsection {NAME}{LEVEL}{INDENT}{BEFORESKIP}{AFTERSKIP}{STYLE} 
%            optional * [ALTHEADING]{HEADING}
%    Generic command to start a section.  
%    NAME       : e.g., 'subsection'
%    LEVEL      : a number, denoting depth of section -- e.g., chapter=1,
%                 section = 2, etc.  A section number will be printed if
%                 and only if LEVEL gt or eq the value of the secnumdepth
%                 counter.
%    INDENT     : Indentation of heading from left margin
%    BEFORESKIP : Absolute value = skip to leave above the heading.  
%                 If negative, then paragraph indent of text following 
%                 heading is suppressed.
%    AFTERSKIP  : if positive, then skip to leave below heading,
%                       else - skip to leave to right of run-in heading.
%    STYLE      : commands to set style
%  If '*' missing, then increments the counter.  If it is present, then
%  there should be no [ALTHEADING] argument.  A sectioning command
%  is normally defined to \@startsection + its first six arguments.

%\renewcommand{\chapter}{%
%\@startsection
%{chapter}{1}{0pt}{-1.5ex plus -1ex minus -.2ex}%
%{1ex plus .2ex}{\normalsize\centering}%
%}


% \renewcommand{\section}{%
% \@startsection
% {section}{1}{0pt}{36pt plus 6pt minus 6pt}%
% {6pt plus 1pt minus 1pt}{\bf\normalsize}%
% % \let\@afterindentfalse % remove indent for first line
% }
\renewcommand{\section}{%
    % Space before: -6.8ex ~ 136pt
    % Space after: 1.3ex ~ 6pt
    \@startsection{section}{1}{\z@}{-6.8ex \@plus -1ex \@minus -.2ex}{1.3ex \@plus.2ex \@minus.2ex}%
    {\bf\normalsize}}

