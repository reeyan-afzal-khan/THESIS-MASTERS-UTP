%   \@startsection
%   {section} % Name of the sectioning command to be redefined
%   {1} % Level of the section
%   {\z@} % Indentation of the heading from the left margin (0 means no indentation)
%   {-1ex \@plus 6pt \@minus 6pt} % Space before the heading (negative value means it can overlap the previous text)
%   {6pt \@plus 1pt \@minus 1pt} % Space after the heading (0 means no space, \@plus and \@minus are stretchable and shrinkable components)
%   {\bf\normalsize} % Formatting of the heading
%   % [indent=0pt]
%   % \let\@afterindentfalse
% }
% \renewcommand{\section}{
% \@startsection
% {section}{1}{\z@}{-1ex \@plus.2ex \@minus.2ex}{1ex \@plus.2ex \@minus.2ex}{\normalfont\large\bfseries}}



\renewcommand{\subsection}{%
    \@startsection
    {subsection}{2}{0pt}{36pt plus 6pt minus 6pt}%
    {6pt plus 1pt minus 1pt}{\bf\normalsize}%
}

\renewcommand{\subsubsection}{%
    \@startsection
    {subsubsection}{3}{0pt}{36pt plus 6pt minus 6pt}%
    {6pt plus 1pt minus 1pt}{\it\normalsize}%
}

\newcommand{\appendixsection}{%
    \@startsection
    {section}{1}{0pt}{3ex plus .5ex minus .5ex}%
    {1ex plus .1ex}{\bf\normalsize}%
}
\newcommand{\appendixsubsection}{%
    \@startsection
    {subsection}{2}{0pt}{3ex plus .5ex minus .5ex}%
    {1ex plus .1ex}{\bf\normalsize}%
}

